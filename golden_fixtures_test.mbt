// Golden cross-language fixtures generated from roaring-wasm (official
// CRoaring WASM port), NOT hand-written. Regenerate via:
//   cd scratch-fixtures && node generate.mjs && node to_mbt.mjs
// These verify byte-for-byte compatibility with real CRoaring output, not
// just internal round-trip consistency.

test "golden fixture: empty matches CRoaring bytes" {
  let values : Array[UInt] = []
  let expected_bytes : Bytes = b"\x3a\x30\x00\x00\x00\x00\x00\x00"
  let bm = RoaringBitmap::from_array(values)
  assert_eq(bm.size(), 0)
  let actual_bytes = bm.serialize(true)
  assert_eq(actual_bytes, expected_bytes)
  // Also verify MoonBit can deserialize CRoaring's own bytes.
  let restored = match RoaringBitmap::deserialize(expected_bytes, true) {
    Ok(r) => r
    Err(_) => fail("expected successful deserialize of CRoaring-generated bytes")
  }
  assert_true(restored.equals(bm))
}

test "golden fixture: sparse_array matches CRoaring bytes" {
  let values : Array[UInt] = [1U, 100U, 1000U, 50000U]
  let expected_bytes : Bytes = b"\x3a\x30\x00\x00\x01\x00\x00\x00\x00\x00\x03\x00\x10\x00\x00\x00\x01\x00\x64\x00\xe8\x03\x50\xc3"
  let bm = RoaringBitmap::from_array(values)
  assert_eq(bm.size(), 4)
  let actual_bytes = bm.serialize(true)
  assert_eq(actual_bytes, expected_bytes)
  // Also verify MoonBit can deserialize CRoaring's own bytes.
  let restored = match RoaringBitmap::deserialize(expected_bytes, true) {
    Ok(r) => r
    Err(_) => fail("expected successful deserialize of CRoaring-generated bytes")
  }
  assert_true(restored.equals(bm))
}

